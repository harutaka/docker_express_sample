{
  "name": "docker_express_sample",
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "start": "node ./dist/src/app",
    "build": "tsc",
    "dev": "tsx --watch ./src/app",
    "lint": "biome check ./src/**/*.ts ./tests",
    "format": "biome format --write ./src ./tests",
    "prepare": "simple-git-hooks",
    "test": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "lint-staged": "^16.2.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm dlx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "pnpm run format"
  }
}
